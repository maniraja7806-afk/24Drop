export interface QuickReactionEditorModalProps {
  isOpen: boolean;
  onClose: () => void;
  onSaved?: (emojis: string[]) => void;
}

export const QuickReactionEditorModal: React.FC<QuickReactionEditorModalProps> = ({
  isOpen,
  onClose,
  onSaved
}) => {
  const [emojis, setEmojis] = useState<string[]>(getCustomReactions);
  const [showPickerForAdd, setShowPickerForAdd] = useState(false);

  useEffect(() => {
    if (isOpen) {
      setEmojis(getCustomReactions());
      setShowPickerForAdd(false);
    }
  }, [isOpen]);

  if (!isOpen) return null;

  const handleMove = (index: number, direction: 'left' | 'right') => {
    const newIdx = direction === 'left' ? index - 1 : index + 1;
    if (newIdx < 0 || newIdx >= emojis.length) return;
    const updated = [...emojis];
    const temp = updated[index];
    updated[index] = updated[newIdx];
    updated[newIdx] = temp;
    setEmojis(updated);
  };

  const handleMakeDefault = (index: number) => {
    if (index === 0) return;
    const updated = [...emojis];
    const item = updated.splice(index, 1)[0];
    updated.unshift(item);
    setEmojis(updated);
  };

  const handleRemove = (emojiToRemove: string) => {
    if (emojis.length <= 1) return; // Keep at least 1
    setEmojis(emojis.filter(e => e !== emojiToRemove));
  };

  const handleAddEmoji = (newEmoji: string) => {
    if (emojis.length >= 6) return;
    if (!emojis.includes(newEmoji)) {
      setEmojis([...emojis, newEmoji]);
    }
    setShowPickerForAdd(false);
  };

  const handleResetDefaults = () => {
    setEmojis(DEFAULT_REACTIONS);
  };

  const handleSave = () => {
    saveCustomReactions(emojis);
    if (onSaved) onSaved(emojis);
    onClose();
  };

  return (
    <AnimatePresence>
      <motion.div
        initial={{ opacity: 0 }}
        animate={{ opacity: 1 }}
        exit={{ opacity: 0 }}
        className="fixed inset-0 bg-black/75 backdrop-blur-md z-[120] flex items-center justify-center p-3 sm:p-4"
        onClick={onClose}
      >
        <motion.div
          initial={{ opacity: 0, scale: 0.9, y: 15 }}
          animate={{ opacity: 1, scale: 1, y: 0 }}
          exit={{ opacity: 0, scale: 0.9, y: 15 }}
          transition={{ type: "spring", damping: 25, stiffness: 350 }}
          className="bg-[#181818] border border-white/15 rounded-3xl w-full max-w-md shadow-2xl overflow-hidden flex flex-col text-white"
          onClick={(e) => e.stopPropagation()}
        >
          {/* Header */}
          <div className="flex items-center justify-between px-5 py-4 border-b border-white/10 bg-[#222222]">
            <div className="flex items-center space-x-2">
              <div className="p-2 rounded-xl bg-gradient-to-br from-yellow-500/20 to-orange-500/20 border border-yellow-500/30 text-yellow-400">
                <Edit2 className="w-5 h-5" />
              </div>
              <div>
                <h3 className="text-base font-bold text-white">Customize Quick Reactions</h3>
                <p className="text-xs text-neutral-400">Set up to 6 quick emojis for instant access</p>
              </div>
            </div>
            <button
              type="button"
              onClick={onClose}
              className="p-1.5 rounded-full text-neutral-400 hover:text-white hover:bg-white/10 transition-colors"
            >
              <X className="w-5 h-5" />
            </button>
          </div>

          <div className="p-5 space-y-5 max-h-[75vh] overflow-y-auto">
            {/* Default reaction notice */}
            <div className="p-3.5 rounded-2xl bg-blue-600/15 border border-blue-500/30 text-xs text-blue-200 flex items-start space-x-2.5">
              <Sparkles className="w-4 h-4 text-blue-400 flex-shrink-0 mt-0.5" />
              <div>
                <strong className="font-semibold text-blue-300">Double Click / Double Tap Default:</strong>
                <p className="mt-0.5 text-blue-200/90 leading-relaxed">
                  The <strong className="text-yellow-300">FIRST emoji</strong> in your quick bar will automatically react when you double-click or double-tap any message.
                </p>
              </div>
            </div>

            {/* Quick reaction row list */}
            <div className="space-y-2.5">
              <div className="flex items-center justify-between text-xs text-neutral-400 font-medium px-1">
                <span>Quick Emojis ({emojis.length}/6)</span>
                {emojis.length < 6 && (
                  <button
                    type="button"
                    onClick={() => setShowPickerForAdd(true)}
                    className="text-blue-400 hover:text-blue-300 font-semibold flex items-center space-x-1"
                  >
                    <Plus className="w-3.5 h-3.5" />
                    <span>Add Emoji</span>
                  </button>
                )}
              </div>

              <div className="space-y-2">
                {emojis.map((emoji, index) => {
                  const isDefault = index === 0;
                  return (
                    <motion.div
                      key={`${emoji}-${index}`}
                      layout
                      className={clsx(
                        "flex items-center justify-between p-3 rounded-2xl border transition-all",
                        isDefault
                          ? "bg-yellow-500/10 border-yellow-500/40 shadow-[0_0_15px_rgba(234,179,8,0.15)]"
                          : "bg-white/5 border-white/10 hover:border-white/20"
                      )}
                    >
                      <div className="flex items-center space-x-3">
                        <span className="text-2xl sm:text-3xl hover:scale-125 transition-transform">{emoji}</span>
                        <div>
                          {isDefault ? (
                            <span className="inline-flex items-center space-x-1 text-[11px] font-bold text-yellow-400 bg-yellow-400/20 px-2 py-0.5 rounded-full border border-yellow-400/30">
                              <Star className="w-3 h-3 fill-yellow-400" />
                              <span>Default (Double Click/Tap)</span>
                            </span>
                          ) : (
                            <span className="text-xs text-neutral-400 font-medium">Position #{index + 1}</span>
                          )}
                        </div>
                      </div>

                      <div className="flex items-center space-x-1">
                        {!isDefault && (
                          <button
                            type="button"
                            onClick={() => handleMakeDefault(index)}
                            className="p-1.5 rounded-xl bg-white/5 hover:bg-yellow-500/20 text-neutral-400 hover:text-yellow-400 transition-colors text-xs flex items-center space-x-1"
                            title="Make default reaction"
                          >
                            <Star className="w-3.5 h-3.5" />
                          </button>
                        )}
                        <button
                          type="button"
                          onClick={() => handleMove(index, 'left')}
                          disabled={index === 0}
                          className="p-1.5 rounded-xl bg-white/5 hover:bg-white/15 text-neutral-400 hover:text-white disabled:opacity-30 disabled:pointer-events-none transition-colors"
                          title="Move left"
                        >
                          <MoveLeft className="w-3.5 h-3.5" />
                        </button>
                        <button
                          type="button"
                          onClick={() => handleMove(index, 'right')}
                          disabled={index === emojis.length - 1}
                          className="p-1.5 rounded-xl bg-white/5 hover:bg-white/15 text-neutral-400 hover:text-white disabled:opacity-30 disabled:pointer-events-none transition-colors"
                          title="Move right"
                        >
                          <MoveRight className="w-3.5 h-3.5" />
                        </button>
                        <button
                          type="button"
                          onClick={() => handleRemove(emoji)}
                          disabled={emojis.length <= 1}
                          className="p-1.5 rounded-xl bg-white/5 hover:bg-red-500/20 text-neutral-400 hover:text-red-400 disabled:opacity-30 disabled:pointer-events-none transition-colors ml-1"
                          title="Remove emoji"
                        >
                          <Trash2 className="w-3.5 h-3.5" />
                        </button>
                      </div>
                    </motion.div>
                  );
                })}
              </div>
            </div>

            {/* Embedded Emoji Picker for adding emoji */}
            {showPickerForAdd && (
              <motion.div
                initial={{ opacity: 0, height: 0 }}
                animate={{ opacity: 1, height: 'auto' }}
                exit={{ opacity: 0, height: 0 }}
                className="pt-2 border-t border-white/10 flex flex-col items-center"
              >
                <div className="flex items-center justify-between w-full mb-2">
